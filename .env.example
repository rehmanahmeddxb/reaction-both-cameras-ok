# ---------------------------------------------------------------------------
# Copy to .env.local  (cp .env.local .env is also fine — server.mjs reads both)
# Every value here is OPTIONAL. The app runs fully offline without any of them;
# the two AI features just fall back to built-in text instead of Gemini calls.
# ---------------------------------------------------------------------------

# Gemini API key → real-time subtitle translation + viral title generator.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Which model the /api/gemini/* endpoints call (server.mjs).
GEMINI_MODEL="gemini-2.5-flash"

# Ports. PORT = the URL you open on your phone. API_PORT is the internal API used by dev mode.
PORT="3000"
API_PORT="3001"

# Set to "true" to disable Vite HMR + file watching (saves battery/CPU in Termux).
DISABLE_HMR="false"
